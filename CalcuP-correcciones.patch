+@app.post("/api/productos/importar-lote")
+def importar_productos_lote(request: ImportarProductosRequest):
+    """Inserta o actualiza productos en una sola operación de red."""
+    # El último producto con un mismo nombre gana. Esto evita operaciones
+    # contradictorias cuando el Excel contiene filas duplicadas.
+    por_nombre: Dict[str, ProductoImportacion] = {}
+    filas_invalidas = 0
+    for producto in request.productos:
+        nombre = producto.nombre.strip()
+        if not nombre:
+            filas_invalidas += 1
+            continue
+        producto.nombre = nombre
+        por_nombre[nombre.casefold()] = producto
+
+    if not por_nombre:
+        raise HTTPException(status_code=400, detail="El archivo no contiene productos válidos")
+
+    existentes = {
+        str(doc.get("nombre", "")).strip().casefold(): doc
+        for doc in productos_col.find({}, {"nombre": 1, "costo": 1, "precio_venta": 1})
+        if str(doc.get("nombre", "")).strip()
+    }
+
+    operaciones = []
+    nuevos = 0
+    actualizados = 0
+    sin_cambios = 0
+    ahora = datetime.now()
+
+    for clave, producto in por_nombre.items():
+        actual = existentes.get(clave)
+        costo = float(producto.costo or 0)
+        precio_venta = float(producto.precio_venta or 0)
+
+        if actual is None:
+            operaciones.append(InsertOne({
+                "nombre": producto.nombre,
+                "costo": costo,
+                "precio_venta": precio_venta,
+                "cantidad": "",
+                "flujo_id": None,
+                "comentarios": producto.comentarios or "",
+                "fecha_creacion": ahora,
+            }))
+            nuevos += 1
+            continue
+
+        costo_cambio = abs(float(actual.get("costo", 0) or 0) - costo) > 0.001
+        precio_cambio = abs(float(actual.get("precio_venta", 0) or 0) - precio_venta) > 0.001
+        if costo_cambio or precio_cambio:
+            operaciones.append(UpdateOne(
+                {"_id": actual["_id"]},
+                {"$set": {
+                    "costo": costo,
+                    "precio_venta": precio_venta,
+                    "fecha_actualizacion": ahora,
+                }},
+            ))
+            actualizados += 1
+        else:
+            sin_cambios += 1
+
+    if operaciones:
+        productos_col.bulk_write(operaciones, ordered=False)
+
+    return {
+        "nuevos": nuevos,
+        "actualizados": actualizados,
+        "sinCambios": sin_cambios,
+        "errores": filas_invalidas,
+        "duplicadosOmitidos": len(request.productos) - len(por_nombre),
+        "procesados": len(por_nombre),
+    }
+
