+  const esperar = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
+
+  const ejecutarConReintento = async <T,>(accion: () => Promise<T>, intentos = 3): Promise<T> => {
+    let ultimoError: unknown;
+    for (let intento = 1; intento <= intentos; intento++) {
+      try {
+        return await accion();
+      } catch (error) {
+        ultimoError = error;
+        const status = (error as { status?: number })?.status;
+        // No repetir errores permanentes del cliente.
+        if (status && status >= 400 && status < 500 && status !== 408 && status !== 429) throw error;
+        if (intento < intentos) await esperar(1000 * intento);
+      }
+    }
+    throw ultimoError;
+  };
+
+  /** Compatibilidad con el backend anterior, que no tenía importación por lotes. */
+  const importarConApiAnterior = async (
+    productos: { nombre: string; costo: number; precio_venta: number }[],
+  ) => {
+    const existingRes = await ejecutarConReintento(() => productosApi.getAll());
+    const existingMap = new Map<string, any>();
+    existingRes.data.forEach((producto: any) => {
+      existingMap.set(String(producto.nombre || '').trim().toLowerCase(), producto);
+    });
+
+    let nuevos = 0;
+    let actualizados = 0;
+    let sinCambios = 0;
+    let errores = 0;
+
+    for (let index = 0; index < productos.length; index++) {
+      const producto = productos[index];
+      const clave = producto.nombre.trim().toLowerCase();
+      if (!clave) {
+        errores++;
+        continue;
+      }
+
+      try {
+        const actual = existingMap.get(clave);
+        if (actual) {
+          const cambioCosto = Math.abs(Number(actual.costo || 0) - producto.costo) > 0.001;
+          const cambioPrecio = Math.abs(Number(actual.precio_venta || 0) - producto.precio_venta) > 0.001;
+          if (cambioCosto || cambioPrecio) {
+            await ejecutarConReintento(() => productosApi.update(actual._id, {
+              ...actual,
+              costo: producto.costo,
+              precio_venta: producto.precio_venta,
+            }));
+            existingMap.set(clave, { ...actual, ...producto });
+            actualizados++;
+          } else {
+            sinCambios++;
+          }
+        } else {
+          const response = await ejecutarConReintento(() => productosApi.create({
+            nombre: producto.nombre,
+            costo: producto.costo,
+            precio_venta: producto.precio_venta,
+            comentarios: '',
+          }));
+          existingMap.set(clave, response.data);
+          nuevos++;
+        }
+      } catch (error) {
+        console.warn(`No se pudo importar la fila ${index + 1}:`, error);
+        errores++;
+      }
+
