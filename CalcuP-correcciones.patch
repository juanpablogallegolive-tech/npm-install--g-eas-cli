+function detailFromResponse(data: unknown): string | undefined {
+  if (!data || typeof data !== 'object') return undefined;
+  const detail = (data as { detail?: unknown }).detail;
+  if (typeof detail === 'string') return detail;
+  if (Array.isArray(detail)) {
+    return detail
+      .map((item) => (typeof item === 'object' && item && 'msg' in item ? String(item.msg) : String(item)))
+      .join('\n');
+  }
+  return undefined;
+}
+
+export function getApiErrorMessage(error: unknown): string {
+  if (!(error instanceof AxiosError) && error instanceof Error) return error.message;
+  if (!axios.isAxiosError(error)) return 'Ocurrió un error inesperado';
+
+  const responseDetail = detailFromResponse(error.response?.data);
+  if (responseDetail) return responseDetail;
+
+  if (error.code === 'ECONNABORTED') {
+    return 'El servidor tardó demasiado en responder. Intenta nuevamente en un momento.';
+  }
+  if (!error.response) {
+    return 'No se pudo conectar con el servidor. Comprueba Internet e intenta nuevamente.';
+  }
+  if (error.response.status === 503) {
+    return 'El servidor está activo, pero la base de datos no está disponible.';
+  }
+  if (error.response.status >= 500) {
+    return 'El servidor presentó un error interno. Intenta nuevamente o revisa Render.';
+  }
+  if (error.response.status === 404) return 'No se encontró el recurso solicitado.';
+  return `La solicitud falló (${error.response.status}).`;
+}
